# ===========================================
# Veyronix Backend Environment
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.
# ===========================================

# ===== NVIDIA NIM (primary LLM provider) =====
# Model ids must include the publisher prefix (nvidia/...), the bare id 404s.
# Get a key at https://build.nvidia.com/
LLM_API_KEY=your_nvidia_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b

# Both router tiers use the same Nemotron model.
LLM_ROUTER_SMALL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_ROUTER_LARGE=nvidia/nemotron-3.5-super-vl-120b-a12b

# ===== LLM rate limiting (NVIDIA NIM free tier is typically 10 RPM) =====
LLM_RPM=10
LLM_MAX_CONCURRENT=3

# Seconds to wait between each 3-agent chunk inside a simulation round.
SIMULATION_CHUNK_WAIT_SECONDS=6

# ===== Flask =====
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# ===== Storage (local SQLite, no Zep) =====
STORAGE_TYPE=local
STORAGE_PATH=./uploads
DATABASE_PATH=./uploads/veyronix.db

# ===== Document processing =====
MAX_CONTENT_LENGTH_MB=50
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# ===== Simulation =====
OASIS_DEFAULT_MAX_ROUNDS=20

# Consolidate and delete raw interactions every N rounds.
MEMORY_CONSOLIDATION_INTERVAL=5

# ===== Simulation depth =====
# Target size of the simulated cast (the graph is expanded into personas).
SIMULATION_MIN_ENTITIES=50
SIMULATION_MAX_ENTITIES=120
# How many agents may post in one round.
SIMULATION_MAX_ACTIVE_PER_ROUND=12
# How many earlier posts an agent sees so it can reply.
SIMULATION_CONTEXT_POSTS=5
# Share of the posts that answer another agent (two-way conversation).
SIMULATION_REPLY_RATIO=0.7

# ===== Report Agent =====
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# ===== Security =====
# Every /api/* route requires: Authorization: Bearer <this value>
API_BEARER_TOKEN=replace-with-a-long-random-bearer-token

# Comma-separated list of allowed frontend origins.
# Production example: https://your-product.vercel.app
# Development example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=./logs/veyronix.log
